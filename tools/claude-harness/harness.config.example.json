{
  "$comment": "Phase 4: ChatGPT Tab 1 coordinator by default, Claude haiku/high worker and Opus/high specialist; Tab 2 only supplies unverified second opinions. Owned Chrome/MCP must be prepared manually. Subscription billing.",
  "factoryRoot": "C:\\AI\\mongoose-factory",
  "dataDir": "claude-data",
  "mongooseBrowserProfile": "C:\\AI\\mongoose-playwright-profile",
  "browser": {
    "mode": "persistent",
    "userDataDir": "C:\\AI\\claude-harness-chatgpt-profile",
    "channel": "chrome",
    "cdpUrl": "http://127.0.0.1:9223",
    "baseUrl": "https://chatgpt.com",
    "replyTimeoutMinutes": 25,
    "submitConfirmSeconds": 30,
    "stableMs": 3000,
    "maxMessageChars": 30000,
    "navigationTimeoutSeconds": 60
  },
  "opencode": {
    "baseUrl": "http://127.0.0.1:4096",
    "port": 4096,
    "passwordEnv": "OPENCODE_SERVER_PASSWORD",
    "executable": null,
    "agent": null,
    "model": {
      "providerID": "strata",
      "modelID": "qwen3.8-flash-next-iq2_xs"
    },
    "taskTimeoutMinutes": 90,
    "pollIntervalMs": 3000,
    "noResponseGraceSeconds": 120,
    "maxSnapshotRefFailures": 6,
    "maxRepeatedBrowserReads": 6,
    "maxRepeatedShellCalls": 6,
    "autoRecoverInspectionLoops": true,
    "manageBackend": false,
    "autoRestartOnFailure": false
  },
  "deepseek": {
    "enabled": false,
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "inputCostPerMTok": 0.27,
    "outputCostPerMTok": 1.1,
    "autoAcceptValidated": true,
    "timeoutSeconds": 60
  },
  "protocol": {
    "reaskOnInvalid": 1,
    "pauseOnSpecialistAttachmentRequest": true,
    "proposeNextOnComplete": false
  },
  "chats": {
    "newCoordinatorPerRun": true,
    "expectedModelLabel": {
      "coordinator": "High",
      "specialist": "High"
    },
    "contextFile": "context/coordinator-context.md",
    "maxDigestChars": 9000,
    "maxContextChars": 14000,
    "desiredModel": {
      "coordinator": {
        "model": "6",
        "effort": "High"
      },
      "specialist": {
        "model": "6",
        "effort": "High"
      }
    },
    "autoSelectModel": true
  },
  "limits": {
    "maxCycles": 30,
    "maxWorkerTasks": 12,
    "maxSpecialistConsultations": 6,
    "maxConsecutiveFailures": 3,
    "maxDurationMinutes": 240,
    "maxDeepseekCalls": 10,
    "maxDeepseekCostUsd": 0.5
  },
  "mcp": {
    "port": 8931,
    "cdpPort": 9224,
    "chromeExecutable": null,
    "entrypoint": null,
    "secretsFile": "C:\\AI\\mongoose-secrets\\demo.env",
    "outputDir": "evidence/playwright"
  },
  "claude": {
    "executable": "claude",
    "argvPrefix": [],
    "billing": "subscription",
    "configDir": null,
    "models": {
      "worker": {
        "model": "haiku",
        "effort": "high"
      },
      "coordinator": {
        "model": "sonnet",
        "effort": "high"
      },
      "specialist": {
        "model": "opus",
        "effort": "high"
      }
    }
  },
  "worker": {
    "allowBash": false,
    "maxTurns": 40,
    "taskTimeoutMinutes": 90,
    "maxIdenticalCalls": 6,
    "maxSnapshotRefFailures": 6,
    "maxRepeatedBrowserReads": 6,
    "maxRepeatedShellCalls": 6,
    "allowBackendRestart": false
  },
  "chromeWindowStyle": "normal",
  "chromeWindowSize": "1920,1080",
  "chromeStartMaximized": true,
  "coordinator": {
    "transport": "chatgpt"
  },
  "externalSecondOpinion": {
    "enabled": true,
    "maxPerRun": 2
  },
  "git": {
    "enabled": false,
    "push": false,
    "mergeBlocked": false
  }
}
