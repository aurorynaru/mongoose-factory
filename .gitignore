# This repo keeps what is needed to build Mongoose projects: AGENTS.md, the skills (.claude/), assets/ (page
# sources, template, preview tools), builds/ and experiments/ records, recipes/, docs/, requests/, mocks/.
# Everything below stays on disk but out of git.

# --- never commit -----------------------------------------------------------
# Harness runtime state: full ChatGPT conversation text, logs, backend PIDs
tools/learning-harness/data/
# Local harness configuration (machine-specific)
tools/learning-harness/harness.config.json
# Build output and dependencies
tools/learning-harness/node_modules/
tools/learning-harness/dist/
node_modules/
# Playwright MCP page snapshots / console logs (hundreds of files that may contain page content)
evidence/playwright/
.playwright-mcp/
# Secrets of any kind (the Mongoose secrets file lives OUTSIDE this folder; keep it that way)
*.env
.env
.env.*
*.pem
*.key
# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/

.claude/settings.local.json

# --- evidence: screenshots and readbacks stay local ---------------------------
# Kept: rollback copies of installed versions and the browser helper scripts the README and playbooks name.
evidence/**
!evidence/**/
!evidence/*/rollback/**
!evidence/BLD-*/*.js

