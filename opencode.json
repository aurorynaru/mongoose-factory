{
  "$schema": "https://opencode.ai/config.json",

  "model": "strata/qwen3.8-flash-next-coder-iq1_m",

  "provider": {
    "tabby": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local TabbyAPI",

      "options": {
        "baseURL": "http://127.0.0.1:5000/v1",
        "apiKey": "{env:TABBY_API_KEY}"
      },

      "models": {
        "Qwen3.8-27B-EXL3-4.00bpw": {
          "name": "Qwen3.8 27B EXL3",

          "reasoning": true,
          "tool_call": true,
          "attachment": true,

          "interleaved": {
            "field": "reasoning_content"
          },

          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },

          "limit": {
            "context": 196608,
            "output": 32768
          }
        }
      }
    },
    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Strata Coder IQ1_M",

      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },

      "models": {
        "qwen3.8-flash-next-coder-iq1_m": {
          "name": "Qwen3.8 Flash Next Coder IQ1_M (Strata)",

          "options": {
            "reasoningEffort": "none"
          },

          "reasoning": true,
          "tool_call": true,
          "attachment": true,

          "interleaved": {
            "field": "reasoning_content"
          },

          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },

          "limit": {
            "context": 196608,
            "output": 16384
          }
        }
      }
    }
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--secrets",
        "C:\\AI\\mongoose-secrets\\demo.env",
        "--user-data-dir",
        "C:\\AI\\mongoose-playwright-profile",
        "--output-dir",
        "C:\\AI\\mongoose-factory\\evidence\\playwright"
      ],
      "enabled": true
    }
  },

  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1920,
      "max_height": 1920,
      "max_base64_bytes": 5242880
    }
  },

  "permission": {
    "doom_loop": "deny",
    "external_directory": "deny",

    "bash": {
      "*": "allow",
      "git push *": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 48000
  }
}
